# CoalLuxe B2B Website Environment Configuration Example
# Copy this file to .env or .env.local to customize environment variables for production

# Target Backend Submission API (Optional)
# If left blank, the website operates in client-side simulated demonstration mode,
# saving submitted RFQ inquiries to browser localStorage with auto-generated reference IDs.
VITE_FORM_SUBMISSION_ENDPOINT=https://api.yourdomain.com/v1/rfq

# WhatsApp Contact Number (digits only, e.g., 84901234567 or 18005550199)
VITE_WHATSAPP_NUMBER=+10000000000

# Google Analytics / Tag Manager (Optional)
VITE_GA_TRACKING_ID=
